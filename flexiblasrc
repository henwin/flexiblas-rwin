default = NETLIB
verbose = 0

[NETLIB]
library = libflexiblas_netlib.dll
comment = Reference BLAS and LAPACK built into FlexiBLAS

[OPENBLAS-THREADS]
library = libopenblas_threads.dll
comment = OpenBLAS with Windows threads

[OPENBLAS-OPENMP]
library = libopenblas_openmp.dll
comment = OpenBLAS with OpenMP (statically linked libgomp)
