diff --git a/src/fallback_blas/CMakeLists.txt b/src/fallback_blas/CMakeLists.txt
index 8983bc2b..27ad30f9 100644
--- a/src/fallback_blas/CMakeLists.txt
+++ b/src/fallback_blas/CMakeLists.txt
@@ -76,12 +76,22 @@ if ( SYS_BLAS_LIBRARY )
     endif()
     target_link_libraries(flexiblas_netlib PUBLIC flexiblas_netlib_import PRIVATE ${LIBM})
 else()
+    set(OBJECTS $<TARGET_OBJECTS:flexiblas_netlib_objs>)
+    if (MINGW)
+        # A DLL calls the XERBLA it is linked with, so the reference one
+        # would stop the program; take FlexiBLAS's, which calls the one the
+        # program supplies, as on ELF platforms by symbol interposition.
+        set(OBJECTS $<FILTER:${OBJECTS},EXCLUDE,/xerbla[_ary]*[.]f[.]>)
+    endif()
     if (FLEXIBLAS_CBLAS)
-        add_library(flexiblas_netlib SHARED ${SRC} $<TARGET_OBJECTS:flexiblas_netlib_objs> $<TARGET_OBJECTS:cblas_obj>)
-    else()
-        add_library(flexiblas_netlib SHARED ${SRC} $<TARGET_OBJECTS:flexiblas_netlib_objs> )
+        set(OBJECTS ${OBJECTS} $<TARGET_OBJECTS:cblas_obj>)
+    endif()
+    add_library(flexiblas_netlib SHARED ${SRC} ${OBJECTS})
+    target_link_libraries(flexiblas_netlib PRIVATE ${LIBM} $<$<BOOL:${MINGW}>:flexiblas>)
+    if (MINGW)
+        include(${PROJECT_SOURCE_DIR}/cmake/def-from-objects.cmake)
+        flexiblas_def_from_objects(flexiblas_netlib)
     endif()
-    target_link_libraries(flexiblas_netlib PRIVATE ${LIBM})
 endif()
 
 
diff --git a/src/fallback_lapack/CMakeLists.txt b/src/fallback_lapack/CMakeLists.txt
index 8a46c44a..5542ba59 100644
--- a/src/fallback_lapack/CMakeLists.txt
+++ b/src/fallback_lapack/CMakeLists.txt
@@ -95,7 +95,13 @@ if ( SYS_LAPACK_LIBRARY )
     add_library(flexiblas_fallback_lapack SHARED ${SRC})
     target_link_libraries(flexiblas_fallback_lapack PUBLIC flexiblas_lapack_import PRIVATE ${LIBM} $<$<BOOL:WIN32>:flexiblas>)
 else()
-    add_library(flexiblas_fallback_lapack SHARED ${SRC} $<TARGET_OBJECTS:flexiblas_fallback_lapack_objs> $<$<TARGET_EXISTS:mod_files>:$<TARGET_OBJECTS:mod_files>>)
+    set(OBJECTS $<TARGET_OBJECTS:flexiblas_fallback_lapack_objs>)
+    if (MINGW)
