     if (MINGW)
         include(${PROJECT_SOURCE_DIR}/cmake/def-from-objects.cmake)
         flexiblas_def_from_objects(flexiblas_fallback_lapack)
diff --git a/src/xerbla.c b/src/xerbla.c
index e1e72663..e266c09d 100644
--- a/src/xerbla.c
+++ b/src/xerbla.c
@@ -100,6 +100,13 @@ void XERBLA(char *SNAME, Int *Info, flexiblas_fortran_charlen_t len) {
 #endif
 
 
+/* The XERBLA handler OpenBLAS calls, see openblas_set_xerbla() */
+static void flexiblas_openblas_xerbla(const char *name, const Int *info, size_t len)
+{
+    Int i = *info;
+    flexiblas_internal_xerbla((char *) name, &i, (flexiblas_fortran_charlen_t) len);
+}
+
 int __flexiblas_setup_xerbla(flexiblas_backend_t *backend)
 {
     /* Check if the user supplied a XERBLA function  */
@@ -116,7 +123,9 @@ int __flexiblas_setup_xerbla(flexiblas_backend_t *backend)
                 (unsigned long)((void*)xerbla_symbol2),
                 (unsigned long)((void*)internal));
 
-        if (internal == xerbla_symbol2) {
+        /* Where xerbla_ is not an alias of the internal one, as on Windows,
+           finding FlexiBLAS's own is not finding the user's. */
+        if (internal == xerbla_symbol2 || xerbla_symbol2 == (void *) xerbla_) {
             user_xerbla = 0;
         } else {
             user_xerbla = 1;
@@ -128,6 +137,15 @@ int __flexiblas_setup_xerbla(flexiblas_backend_t *backend)
         } else {
             DPRINTF(1,"Use XERBLA supplied by the user.\n");
             backend->xerbla = xerbla_symbol2;
+            /* OpenBLAS calls its own XERBLA where symbol interposition does
+               not reach it, as on Windows; since 0.3.34 it can be replaced. */
+            {
+                void *(*set_handler)(void *) = (void *(*)(void *)) __flexiblas_dlsym(backend->library_handle, "openblas_set_xerbla");
+                if (set_handler != NULL) {
+                    DPRINTF(1,"Pass the XERBLA supplied by the user to OpenBLAS.\n");
+                    set_handler((void *) flexiblas_openblas_xerbla);
+                }
+            }
         }
     }
     return 0;
