diff --git a/src/fallback_lapack/CMakeLists.txt b/src/fallback_lapack/CMakeLists.txt
index 34aee1a0..3952af48 100644
--- a/src/fallback_lapack/CMakeLists.txt
+++ b/src/fallback_lapack/CMakeLists.txt
@@ -95,6 +95,23 @@ if ( SYS_LAPACK_LIBRARY )
     add_library(flexiblas_fallback_lapack SHARED ${SRC})
     target_link_libraries(flexiblas_fallback_lapack PUBLIC flexiblas_lapack_import PRIVATE ${LIBM} $<$<BOOL:WIN32>:flexiblas>)
 else()
+    if (WIN32)
+        # The fallback links against libflexiblas, whose import library has
+        # the same LAPACK names, and lld leaves a symbol out of the automatic
+        # export when an import library provides it too.  Export what the
+        # objects define, from a .def made from them.
+        set(_objects $<TARGET_OBJECTS:flexiblas_fallback_lapack_objs> $<$<TARGET_EXISTS:mod_files>:$<TARGET_OBJECTS:mod_files>>)
+        if (LAPACKE)
+            list(APPEND _objects $<TARGET_OBJECTS:lapacke>)
+        endif()
+        file(GENERATE OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/fallback_lapack_objects.txt CONTENT "$<JOIN:${_objects},\n>\n")
+        add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/flexiblas_fallback_lapack.def
+            COMMAND ${CMAKE_COMMAND} -DNM=${CMAKE_NM} -DOBJECTS_FILE=${CMAKE_CURRENT_BINARY_DIR}/fallback_lapack_objects.txt
+                    -DDEF=${CMAKE_CURRENT_BINARY_DIR}/flexiblas_fallback_lapack.def -P ${PROJECT_SOURCE_DIR}/cmake/def-from-objects.cmake
+            DEPENDS ${_objects} ${PROJECT_SOURCE_DIR}/cmake/def-from-objects.cmake
+            COMMAND_EXPAND_LISTS VERBATIM)
+        list(APPEND SRC ${CMAKE_CURRENT_BINARY_DIR}/flexiblas_fallback_lapack.def)
+    endif()
     add_library(flexiblas_fallback_lapack SHARED ${SRC} $<TARGET_OBJECTS:flexiblas_fallback_lapack_objs> $<$<TARGET_EXISTS:mod_files>:$<TARGET_OBJECTS:mod_files>>)
     target_link_libraries(flexiblas_fallback_lapack PRIVATE ${LIBM} $<$<BOOL:WIN32>:flexiblas>)
 endif()
diff --git a/cmake/def-from-objects.cmake b/cmake/def-from-objects.cmake
new file mode 100644
index 00000000..58a96044
--- /dev/null
+++ b/cmake/def-from-objects.cmake
@@ -0,0 +1,29 @@
+# Writes a module-definition (.def) file that exports every external
+# symbol defined in the objects listed, one per line, in OBJECTS_FILE, as R
+# makes its own:
+#   cmake -DNM=<nm> -DOBJECTS_FILE=<file> -DDEF=<file> -P def-from-objects.cmake
+# nm reads the objects from a response file, which keeps the command line
+# short whatever their number.
+file(STRINGS ${OBJECTS_FILE} _objects)
+list(TRANSFORM _objects PREPEND "\"")
+list(TRANSFORM _objects APPEND "\"")
+string(REPLACE ";" "\n" _objects "${_objects}")
+file(WRITE ${DEF}.rsp "${_objects}\n")
+execute_process(COMMAND ${NM} -g --defined-only @${DEF}.rsp
+                OUTPUT_VARIABLE _nm RESULT_VARIABLE _status)
+if (NOT _status EQUAL 0)
+    message(FATAL_ERROR "${NM} failed on the objects in ${OBJECTS_FILE}")
+endif()
+string(REGEX MATCHALL "[^\n]* [BCDRT] [^\n]*" _lines "${_nm}")
+set(_symbols)
+foreach (_line ${_lines})
+    string(REGEX REPLACE "^.* [BCDRT] " "" _symbol "${_line}")
+    # the compiler's .refptr. and .weak. symbols are not for export
+    if (NOT _symbol MATCHES "^[.]")
+        list(APPEND _symbols ${_symbol})
+    endif()
+endforeach()
+list(REMOVE_DUPLICATES _symbols)
+list(SORT _symbols)
+string(REPLACE ";" "\n " _symbols "${_symbols}")
+file(WRITE ${DEF} "EXPORTS\n ${_symbols}\n")
