Index: src/modules/lapack/Makefile.win
===================================================================
--- src/modules/lapack/Makefile.win	(revision 90763)
+++ src/modules/lapack/Makefile.win	(working copy)
@@ -39,18 +39,42 @@
 
 libRlapack.dll.a: Rlapack.def
 
-Rlapack.def: $(LIBOBJECTS)
+## FlexiBLAS only when Rblas.dll uses it: ATLAS and OpenBLAS come first in
+## ../../extra/blas/Makefile.win
+ifeq "$(USE_ATLAS)$(USE_OPENBLAS)$(USE_FLEXIBLAS)" "NONOYES"
+## Rlapack.dll forwards to libflexiblas.dll the entry points FlexiBLAS has:
+## all but dlarscl2 and dlascl2, which LAPACK builds only with its
+## extra-precise routines and nothing in R calls, and la_xisnan's module
+## procedures, which are internal.
+FLEXIBLAS_PATH = ../../../FlexiBLAS
+FLEXIBLAS_SYMS = flexiblas.syms
+FLEXIBLAS_FILTER = | grep -F -x -f flexiblas.syms
+
+flexiblas.syms: $(FLEXIBLAS_PATH)/$(BINDIR)/libflexiblas.dll.a
+	@$(NM) $< | $(SED) -n $(SYMPAT) > $@
+
+Rlapack-flexiblas.def: Rlapack.def
+	$(SED) -e 's/^ \(.*\)/ \1 = libflexiblas.\1/' $< > $@
+endif
+
+Rlapack.def: $(LIBOBJECTS) $(FLEXIBLAS_SYMS)
 	@$(ECHO) EXPORTS > $@
-	@$(NM) $^ | $(SED) -n $(SYMPAT) | $(SORT) | uniq >> $@
+	@$(NM) $(LIBOBJECTS) | $(SED) -n $(SYMPAT) | $(SORT) | uniq $(FLEXIBLAS_FILTER) >> $@
 
 
 $(MODULE).dll: $(OBJS)
 
+ifeq "$(USE_ATLAS)$(USE_OPENBLAS)$(USE_FLEXIBLAS)" "NONOYES"
+../../../$(BINDIR)/Rlapack.dll: Rlapackrc.o Rlapack-flexiblas.def
+	$(DLL) -shared -s -o $@ $^
+else
 ../../../$(BINDIR)/Rlapack.dll: $(LIBOBJECTS) Rlapack.def
 	$(DLL) -shared -s -o $@ $^ -L../../../$(IMPDIR) -lR -lRblas $(FLIBS)
+endif
 
 clean:
 	@$(RM) Makedeps *.d *.o $(MODULE).def $(MODULE).dll Rlapack.def \
+	  Rlapack-flexiblas.def flexiblas.syms \
 	  Rlapack.dll *.a *.mod
 
 
