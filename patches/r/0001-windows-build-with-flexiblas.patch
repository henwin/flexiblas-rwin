Index: src/extra/blas/Makefile.win
===================================================================
--- src/extra/blas/Makefile.win	(revision 90763)
+++ src/extra/blas/Makefile.win	(working copy)
@@ -17,6 +17,19 @@
 	@$(ECHO) -------- Building $@ --------
 	$(DLL) -s -shared $(DLLFLAGS) -o $@ $^ Rblas.def \
 	    -L../../../$(IMPDIR) -lR  $(shell $(PKG_CONFIG) --libs openblas)
+else ifeq "$(USE_FLEXIBLAS)" "YES"
+## Rblas.dll forwards its entry points to libflexiblas.dll, which comes with
+## its backends and configuration from the FlexiBLAS bundle
+FLEXIBLAS_PATH = ../../../FlexiBLAS
+../../../$(BINDIR)/Rblas.dll: ../../gnuwin32/dllversion.o Rblas-flexiblas.def
+	@$(ECHO) -------- Building $@ --------
+	$(CP) -pR $(FLEXIBLAS_PATH)/$(BINDIR)/*.dll $(FLEXIBLAS_PATH)/$(BINDIR)/flexiblas \
+	  ../../../$(BINDIR)
+	$(CP) -pR $(FLEXIBLAS_PATH)/etc/flexiblasrc* ../../../etc
+	$(DLL) -s -shared $(DLLFLAGS) -o $@ $^
+
+Rblas-flexiblas.def: Rblas.def
+	$(SED) -e 's/^ \(.*\)/ \1 = libflexiblas.\1/' $< > $@
 else
 ../../../$(BINDIR)/Rblas.dll: blas.o blas2.o cmplxblas.o cmplxblas2.o ../../gnuwin32/dllversion.o
 	@$(ECHO) -------- Building $@ --------
@@ -24,5 +37,6 @@
 endif
 
 distclean clean:
-	@$(RM) ../../../$(BINDIR)/Rblas.dll *~ blas.o cmplxblas.o
+	@$(RM) ../../../$(BINDIR)/Rblas.dll *~ blas.o cmplxblas.o \
+	  Rblas-flexiblas.def
 
