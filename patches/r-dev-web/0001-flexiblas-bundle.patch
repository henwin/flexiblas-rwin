Index: winutf8/ucrt3/r/build.sh
===================================================================
--- winutf8/ucrt3/r/build.sh	(revision 6991)
+++ winutf8/ucrt3/r/build.sh	(working copy)
@@ -7,6 +7,9 @@
 #   for target x86_64:   
 #     gcc14_ucrt3_full*tar.zst (single file, see ../toolchain_libs)
 #     Tcl*.zip (single file, name not including aarch64, see ../tcl_bundle)
+#     FlexiBLAS*.zip (optional, single file, name not including aarch64,
+#       see ../flexiblas_bundle); when present, R is built with
+#       USE_FLEXIBLAS = YES
 #
 #   for target aarch64:
 #     llvm19_ucrt3_full_aarch64*tar.zst
@@ -154,11 +157,13 @@
   TRIPLET=aarch64-w64-mingw32.static.posix
   TCFILE=`ls -1 llvm19_ucrt3_full_aarch64*tar.zst | head -1`
   TCLFILE=`ls -1 Tcl-aarch64*zip | head -1`
+  FBFILE=`ls -1 FlexiBLAS-aarch64*zip 2>/dev/null | head -1`
   TCTS=llvm19_ucrt3.ts 
 else
   TRIPLET=x86_64-w64-mingw32.static.posix
   TCFILE=`ls -1 gcc14_ucrt3_full*tar.zst | head -1`
   TCLFILE=`ls -1 Tcl*zip | grep -v aarch64 | head -1`
+  FBFILE=`ls -1 FlexiBLAS*zip 2>/dev/null | grep -v aarch64 | head -1`
   TCTS=gcc14_ucrt3.ts
 fi
 
@@ -260,6 +265,9 @@
 svn diff > ../build/ucrt3.diff
 svn info --show-item revision > ../build/svn_revision
 unzip ../$TCLFILE
+if [ "X$FBFILE" != X ] ; then
+  unzip ../$FBFILE
+fi
 
 # Not needed as we use Schannel - https://curl.se/docs/sslcerts.html
 cd etc
@@ -280,6 +288,10 @@
 ISDIR = ${MISDIR}
 EOF
 
+if [ "X$FBFILE" != X ] ; then
+  echo "USE_FLEXIBLAS = YES" >> MkRules.local
+fi
+
 if [ "X${QPDFDIR}" != X ] ; then
   export R_QPDF="${QPDFDIR}/bin/qpdf"
   cat <<EOF >> MkRules.local
Index: winutf8/ucrt3/r/build_in_docker.sh
===================================================================
--- winutf8/ucrt3/r/build_in_docker.sh	(revision 6991)
+++ winutf8/ucrt3/r/build_in_docker.sh	(working copy)
@@ -11,6 +11,8 @@
 #   Tcl*.zip (single file, see ../tcl_bundle)
 #
 # These files may be present in the current directory:
+#   FlexiBLAS*.zip (single file, see ../flexiblas_bundle); when present,
+#     R is built with USE_FLEXIBLAS = YES
 #   "installers" - directory with pre-downloaded installers of the needed
 #     software - note that exact file names with versions are hard-coded in
 #     the script setup.ps1
@@ -118,6 +120,10 @@
 docker cp $TCFILE $CID:\\r
 BFILE=`ls -1 Tcl*.zip | head -1`
 docker cp $BFILE $CID:\\r
+FBFILE=`ls -1 FlexiBLAS*.zip 2>/dev/null | head -1`
+if [ "X$FBFILE" != X ] ; then
+  docker cp $FBFILE $CID:\\r
+fi
 BINFILE=`ls -1 r_binaries*.tar.zst | head -1`
 if [ "X$BINFILE" != X ] && [ -r "$BINFILE" ] ; then
   docker cp $BINFILE $CID:\\r
