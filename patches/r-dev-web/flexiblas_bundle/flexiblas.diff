 string(REGEX REPLACE \\\\ \\\\\\\\ WIN_CMAKE_INSTALL_FULL_SYSCONFDIR "${WIN_CMAKE_INSTALL_FULL_SYSCONFDIR}")
+# location of the global configuration relative to the directory holding
+# the FlexiBLAS DLLs, so that an installation stays relocatable
+file(RELATIVE_PATH FLEXIBLAS_WIN_SYSCONFDIR_REL "${CMAKE_INSTALL_FULL_BINDIR}" "${CMAKE_INSTALL_FULL_SYSCONFDIR}")
+FILE(TO_NATIVE_PATH "${FLEXIBLAS_WIN_SYSCONFDIR_REL}" FLEXIBLAS_WIN_SYSCONFDIR_REL)
+string(REGEX REPLACE \\\\ \\\\\\\\ FLEXIBLAS_WIN_SYSCONFDIR_REL "${FLEXIBLAS_WIN_SYSCONFDIR_REL}")
+MESSAGE(STATUS "SYSCONFDIR relative to BINDIR: ${FLEXIBLAS_WIN_SYSCONFDIR_REL}")
 ENDIF()
 
